{
  // For editors only. Node runs the .ts files directly. There is no build step.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "cli/**/*.ts",
    "shared/**/*.ts",
    "examples/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": ["cli/templates", "node_modules"]
}
