# MEGA examples: provider keys.
# Run `npx mex setup` to fill this in with hidden input, or copy this file to .env.
# Every example that needs a key calls a paid API on your own account.
# One key is enough. When both are set, examples use OpenRouter.

# OpenRouter: one key for models from OpenAI, Anthropic, Google, xAI and more.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: change the default models.
# `npx mex doctor --models` lists the models your key can use.
# MEGA_OPENROUTER_MODEL=openai/gpt-6-luna
# MEGA_OPENROUTER_SMALL_MODEL=openai/gpt-5-nano
# MEGA_OPENROUTER_LOGPROBS_MODEL=meta-llama/llama-3.1-8b-instruct
# MEGA_OPENAI_MODEL=gpt-6-luna
# MEGA_OPENAI_SMALL_MODEL=gpt-5-nano
# MEGA_OPENAI_LOGPROBS_MODEL=gpt-6-luna
# MEGA_OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# MEGA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: send a provider's requests to another address, such as a proxy.
# MEGA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MEGA_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: next-token-probabilities reads token probabilities from
# /chat/completions, for a local server such as Ollama.
# MEGA_LOGPROBS_API=chat
